# --- Docker Compose (aucun mot de passe ni token ici) ---
DOCKERHUB_USERNAME=votre_compte_dockerhub
# Tag à déployer : latest ou sha-xxxxxxx
IMAGE_TAG=latest

# --- Application ---
# Entre conteneurs, l'API se joint par le nom du service Compose
METRICS_ENDPOINT=http://api:8000/metrics
# Hors Docker : METRICS_ENDPOINT=http://127.0.0.1:8000/metrics
COLLECTION_INTERVAL=5
REQUEST_TIMEOUT=5